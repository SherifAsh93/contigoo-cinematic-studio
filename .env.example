# The web app and ComfyUI run independently. Leave empty to explore/save drafts.
COMFYUI_URL=http://127.0.0.1:8188
# Optional bearer token for a private ComfyUI reverse proxy.
COMFYUI_API_KEY=
# Relative to studio/, or use an absolute path.
STUDIO_DATA_DIR=.data
# JSON mapping model IDs to workflow profiles. See workflows/README.md.
STUDIO_WORKFLOWS=workflows/profiles.json
